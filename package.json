{
  "name": "slope-works",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/firebase-config.mjs && ng serve --port 5000",
    "build": "node scripts/firebase-config.mjs && ng build && node scripts/localize-static.mjs dist/SlopeWorks/browser https://slopeworks.nl nl",
    "build:eu": "node scripts/firebase-config.mjs && ng build --configuration production,eu && node scripts/localize-static.mjs dist/slopeworks-eu/browser https://slopeworks.eu en",
    "build:be": "node scripts/firebase-config.mjs && ng build --configuration production,be && node scripts/localize-static.mjs dist/slopeworks-be/browser https://slopeworks.be nl",
    "build:all": "npm run build && npm run build:eu && npm run build:be",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/firebase-config.mjs && ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "22.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@lucide/angular": "^1.23.0",
    "@tailwindcss/postcss": "^4.1.18",
    "firebase": "^12.19.0",
    "gsap": "^3.14.2",
    "lucide": "^1.55.0",
    "mn-angular-lib": "^2.0.28",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/node": "^20.19.43",
    "jsdom": "^27.1.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
