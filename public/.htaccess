# Static-hosting rules for the prerendered SlopeWorks build (Apache).
# scripts/localize-static.mjs appends the `ErrorDocument 404` line per domain.

# --- Text compression ---------------------------------------------------------
# Brotli where available, gzip as fallback. Images/fonts (webp/woff2) are already
# compressed, so only text assets are listed here.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Caching ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Fingerprinted build assets (Angular hashes JS/CSS/font filenames): cache forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Static images keep stable filenames, so cache a month rather than forever.
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML plus the runtime-fetched config/i18n must revalidate so a deploy is seen.
  <FilesMatch "\.(html|json|json5)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
