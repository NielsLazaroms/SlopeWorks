/**
 * This file is used to configure the application's content and behavior.
 * It uses the JSON5 format, which allows for comments, trailing commas, and more.
 *
 * How it works:
 * - "defaults": Contains the default configuration for various components. These values
 *   are used if no specific override is provided.
 * - "overrides": Contains specific configuration overrides organized by route and section.
 *   - "root": The base level for overrides.
 *   - "home", "navbar", "footer": Specific areas of the application where defaults can be overridden.
 *
 * How to edit:
 * - You can change text, image URLs, and other properties within the JSON objects.
 * - Use double or single quotes for keys and string values.
 * - Ensure the JSON structure remains valid (matched braces and brackets).
 */
{
  settings: {
    name: "SlopeWorks",
    version: "1.0.0",
  },
  language: {
    urlPattern: "assets/i18n/{locale}.json",
    defaultLocale: "en",
    preload: ["en", "nl"],
    domainLocaleMap: {
      "slopeworks.nl": "nl",
      "slopeworks.be": "nl",
      "slopeworks.eu": "en",
    }
  },
  "defaults": {
    "mn-input-field": {
      "placeholder": "Enter text here...",
      "label": "Input field",
      "ariaLabel": "Global accessible label",
      errorMessages: {
        required: { $translate: "validation.required" },
        email: { $translate: "validation.email" }
      }
    },
    "mn-textarea": {
      placeholder: "Default textarea placeholder",
      label: "Generic Textarea",
      errorMessages: {
        required: { $translate: "validation.required" },
        minlength: { $translate: "validation.minlength" },
        maxlength: { $translate: "validation.maxlength" }
      }
    },
    "mn-checkbox": {
      errorMessages: {
        required: { $translate: "validation.required" }
      }
    },
    "mn-datetime": {
      errorMessages: {
        required: { $translate: "validation.required" },
        mnMin: { $translate: "validation.mnMin" },
        mnMax: { $translate: "validation.mnMax" }
      }
    },
    "mn-multi-select": {
      errorMessages: {
        required: { $translate: "validation.multiselect.required" }
      }
    }
  },
  "overrides": {
    "root": {
      "home": {
        "why-section": {
          "app-why-section": {
            "label": { $translate: "home.why.label" },
            "title": { $translate: "home.why.title" },
            "intro": { $translate: "home.why.intro" },
            "introSecondary": { $translate: "home.why.introSecondary" },
            "them": {
              "head": { $translate: "home.why.them.head" },
              "items": [
                { $translate: "home.why.them.item1" },
                { $translate: "home.why.them.item2" },
                { $translate: "home.why.them.item3" },
                { $translate: "home.why.them.item4" }
              ]
            },
            "us": {
              "head": { $translate: "home.why.us.head" },
              "items": [
                { $translate: "home.why.us.item1" },
                { $translate: "home.why.us.item2" },
                { $translate: "home.why.us.item3" },
                { $translate: "home.why.us.item4" }
              ]
            }
          }
        },
        "proof-section": {
          "app-proof-section": {
            "label": { $translate: "home.proof.label" },
            "title": { $translate: "home.proof.title" },
            "cards": [
              {
                "tag": { $translate: "home.proof.card1.tag" },
                "title": { $translate: "home.proof.card1.title" },
                "body": { $translate: "home.proof.card1.body" },
                "stamp": { $translate: "home.proof.stamp" },
                "imageUrl": "/images/proof/raclettewandeling.webp",
                "imageAlt": { $translate: "home.proof.card1.title" }
              },
              {
                "tag": { $translate: "home.proof.card2.tag" },
                "title": { $translate: "home.proof.card2.title" },
                "body": { $translate: "home.proof.card2.body" },
                "stamp": { $translate: "home.proof.stamp" },
                "imageUrl": "/images/proof/hintertux-gletsjer.webp",
                "imageAlt": { $translate: "home.proof.card2.title" }
              },
              {
                "tag": { $translate: "home.proof.card3.tag" },
                "title": { $translate: "home.proof.card3.title" },
                "body": { $translate: "home.proof.card3.body" },
                "stamp": { $translate: "home.proof.stamp" },
                "imageUrl": "/images/proof/vijf-minuten-bus.webp",
                "imageAlt": { $translate: "home.proof.card3.title" }
              }
            ]
          }
        },
        "teambuilding-section": {
          "app-teambuilding-section": {
            "label": { $translate: "home.teambuilding.label" },
            "title": { $translate: "home.teambuilding.title" },
            "intro": { $translate: "home.teambuilding.intro" },
            "introSecondary": { $translate: "home.teambuilding.introSecondary" },
            "buttonText": { $translate: "home.teambuilding.button" },
            "buttonRoute": "/over-ons",
            "partner": {
              "initials": "KV",
              "name": "Kamp Vuur",
              "role": { $translate: "home.teambuilding.partner.role" },
              "quote": { $translate: "home.teambuilding.partner.quote" },
              "site": "kamp-vuur.nl"
            }
          }
        },
        "destinations-section": {
          "app-destinations-section": {
            "label": { $translate: "home.destinations.label" },
            "title": { $translate: "home.destinations.title" },
            "seeAllText": { $translate: "home.destinations.seeAll" },
            "seeAllRoute": "/bestemmingen",
            "cards": [
              {
                "country": { $translate: "home.destinations.card1.country" },
                "name": "Sölden",
                "tagline": { $translate: "home.destinations.card1.tagline" },
                "linkText": { $translate: "home.destinations.card1.link" },
                "imageUrl": "/images/destinations/solden.webp",
                "imageAlt": { $translate: "home.destinations.card1.tagline" },
                "route": "/bestemmingen/solden"
              },
              {
                "country": { $translate: "home.destinations.card2.country" },
                "name": "Mayrhofen",
                "tagline": { $translate: "home.destinations.card2.tagline" },
                "linkText": { $translate: "home.destinations.card2.link" },
                "imageUrl": "/images/destinations/mayrhofen.webp",
                "imageAlt": { $translate: "home.destinations.card2.tagline" },
                "route": "/bestemmingen/mayrhofen"
              },
              {
                "country": { $translate: "home.destinations.card3.country" },
                "name": "Gstaad",
                "tagline": { $translate: "home.destinations.card3.tagline" },
                "linkText": { $translate: "home.destinations.card3.link" },
                "imageUrl": "/images/destinations/gstaad.webp",
                "imageAlt": { $translate: "home.destinations.card3.tagline" },
                "route": "/bestemmingen/gstaad"
              }
            ]
          }
        },
        "cta-strip-section": {
          "app-cta-strip-section": {
            "title": { $translate: "home.cta.title" },
            "sub": { $translate: "home.cta.sub" },
            "buttonText": { $translate: "home.cta.button" },
            "buttonRoute": "/contact"
          }
        }
      },
      "contact": {
        "contact-section": {
          "#section-title-getInTouch": {
            "title": { $translate: "home.contact.title" }
          },
          "app-contact-section": {
            "informationDescription": { $translate: "home.contact.informationDescription" },
            "formDescription": { $translate: "home.contact.formDescription" },
            "formButtonText": { $translate: "home.contact.formButton" },
            "emailSalutation": { $translate: "home.contact.emailSalutation" },
            "emailClosing": { $translate: "home.contact.emailClosing" },
            "contactEmail": "info@slopeworks.nl"
          },
          "#location-item": {
            "title": { $translate: "home.contact.location.title" },
            "description": { $translate: "home.contact.location.description" }
          },
          "#email-item": {
            "title": { $translate: "home.contact.email.title" },
            "description": { $translate: "home.contact.email.description" }
          },
          "#call-item": {
            "title": { $translate: "home.contact.call.title" },
            "description": { $translate: "home.contact.call.description" }
          },
          "form": {
            "#section-title-form": {
              title: { $translate: "home.contact.form.title" }
            },
            // Visible field labels are rendered by the contact section's own
            // template (reactive editorial labels), so no `label` is configured
            // here. mn-input-field overwrites its config `placeholder` with
            // `props`, so the name/subject placeholders are supplied from the
            // component instead (see `nameProps`/`subjectProps`); the textarea
            // guards that override and keeps its config placeholder below. Each
            // field keeps its accessible label here for screen readers.
            "#mn-input-name": {
              "ariaLabel": { $translate: "home.contact.form.name.ariaLabel" }
            },
            "#mn-input-subject": {
              "ariaLabel": { $translate: "home.contact.form.subject.ariaLabel" }
            },
            "#mn-textarea-description": {
              "placeholder": { $translate: "home.contact.form.description.placeholder" },
              // Empty string suppresses the library's own label (the global
              // `mn-textarea` default is "Generic Textarea"); the visible label
              // is rendered by this section's template instead.
              "label": "",
              "ariaLabel": { $translate: "home.contact.form.description.ariaLabel" }
            }
          }
        }
      },
      "navbar": {
        "app-navbar": {
          "logoSrc": "logo_slopeworks.svg",
          "logoAlt": "SlopeWorks",
          "navItems": [
            {
              "label": { $translate: "navbar.home" },
              "route": "/"
            },
            {
              "label": { $translate: "navbar.destinations" },
              "route": "/bestemmingen"
            },
            {
              "label": { $translate: "navbar.about" },
              "route": "/over-ons"
            },
            {
              "label": { $translate: "navbar.faq" },
              "route": "/faq"
            },
            {
              "label": { $translate: "navbar.comparison" },
              "route": "/vergelijken"
            }
          ],
          "contactItem": {
            "label": { $translate: "navbar.contact" },
            "route": "/contact"
          }
        }
      },
      "footer": {
        "app-footer": {
          "logoSrc": "logo_slopeworks.svg",
          "logoAlt": "SlopeWorks",
          "copyrightText": { $translate: "footer.copyright" },
          "links": [
            {
              "label": "LinkedIn",
              "href": "https://www.linkedin.com/company/slopeworks/"
            },
            {
              "label": "Instagram",
              "href": "https://www.instagram.com/slopeworks_ski/"
            }
          ],
          "email": "info@slopeworks.nl",
          "phone": "+32 468 41 12 87",
          "addressLines": [
            "Rodekruisstraat 64/1",
            "3920 Lommel"
          ],
          "companyNumber": "BE 1036.649.787",
          "vatNumber": "BE 1036.649.787"
        }
      }
    }
  }
}
